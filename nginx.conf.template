# Bilder lange cachen; HTML und alles andere fragt per ETag nach (Anforderung 13). Ein map statt
# add_header je location: Ein add_header im location-Block hebt die Sicherheitsköpfe des Servers auf.
map $uri $cache_control {
    default                                  "no-cache";
    ~*\.(png|jpe?g|webp|svg|ico)$            "public, max-age=604800";
}

# Eine Hauptadresse (SEO): www.deltatree.de leitet dauerhaft auf deltatree.de, mit Pfad.
server {
    listen 8080;
    server_name www.deltatree.de;
    server_tokens off;
    location = /healthz { access_log off; return 200 "ok\n"; }
    location / { return 301 https://deltatree.de$request_uri; }
}

server {
    listen 8080 default_server;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # Umleitungen relativ halten. Ohne das baut nginx eine absolute Adresse aus seinem
    # EIGENEN Port und Schema: /impressum.html landete auf http://deltatree.de:8080/ —
    # unerreichbar. Gemessen am 2026-09-23 in Produktion.
    absolute_redirect off;

    # Die Seite ist eine einzige Datei. .gz und .br liegen daneben und werden
    # ausgeliefert, statt bei jeder Anfrage neu zu packen.
    gzip_static on;
    gzip on;
    gzip_types text/html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    # __SCRIPT_SRC__ setzt build-csp.py beim Bau des Abbilds ein: 'self' plus den
    # SHA-256-Hash jedes Inline-Skripts. Kein 'unsafe-inline' — der Browser fuehrt
    # genau diese Bytes aus und nichts sonst.
    # data: bei img-src, weil die Seite ein Bild eingebettet traegt.
    # connect-src: Die Seite prueft live, ob Anwendung und Schnittstelle erreichbar sind
    # (die zwei Statuszeilen). Ohne diese beiden Herkuenfte zeigte sie dauerhaft "offline",
    # ohne dass jemand einen Fehler saehe. test/check.sh liest die Ziele aus der Seite und
    # haelt sie gegen diese Zeile — ein neues Ziel macht den Bau rot.
    add_header Content-Security-Policy "default-src 'self'; script-src __SCRIPT_SRC__; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://dtadmin-frontend.capps.dtcloud.de https://dtadmin-backend.capps.dtcloud.de; form-action 'none'; base-uri 'none'; frame-ancestors 'none'" always;
    # Nur auf Serverebene: ein add_header im location-Block hebt diese hier auf.
    add_header Cache-Control $cache_control always;

    location = /healthz { access_log off; return 200 "ok\n"; }

    # Die Rechtstexte stehen jetzt IN der Seite. Alte Links bleiben trotzdem heil:
    # das Skript oeffnet den passenden Dialog anhand des Ankers.
    # Nur wer /index.html AUFRUFT, wird umgeleitet. „index“ und try_files leiten intern ebenfalls auf
    # /index.html; dort ist $request_uri weiter „/“ — sonst entstünde eine Schleife.
    location = /index.html { if ($request_uri ~ "^/index\.html") { return 301 /; } }
    location = /impressum.html   { return 301 /#impressum; }
    location = /datenschutz.html { return 301 /#datenschutz; }
    location = /agb.html         { return 301 /#agb; }

    # Digitale Visitenkarte (SPEC 17–21). Feste Adresse: Der gedruckte QR-Code zeigt auf /visit.
    location = /visit { try_files /visit/index.html =404; }
    location = /visit/ { return 301 /visit; }
    # Eigene Typen nur hier; kein add_header im Block, sonst fielen die Sicherheitsköpfe weg.
    location ~ ^/visit/[a-z0-9-]+\.vcf$ { types { } default_type "text/vcard; charset=utf-8"; }
    location = /visit/manifest.webmanifest { types { } default_type application/manifest+json; }
    # Für KI-Assistenten (llmstxt.org): Markdown. robots.txt und sitemap.xml liefert nginx mit Standardtyp.
    location = /llms.txt { types { } default_type "text/markdown; charset=utf-8"; }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
